# =============================================================================
# AMAZON SAFETY PRO — Vercel handoff env file
# =============================================================================
# Hand this to the new Vercel account owner. They paste these into:
#   Vercel dashboard → New Project → Import → Environment Variables
# OR set them after import via: Project → Settings → Environment Variables.
#
# This file is auto-gitignored (matches .env*.local).
# =============================================================================


# ─── REQUIRED · Public site config ──────────────────────────────────────────
# Safe values — already confirmed from current local .env.

NEXT_PUBLIC_APP_NAME=Amazon Safety Pro
NEXT_PUBLIC_EMAIL=info@amazonsafetypro.com
ADMIN_EMAIL=deepak@amazonsafetypro.com

# Update this to the FINAL production URL on the new Vercel account
# (e.g. https://amazonsafetypro.com once domain is reattached)
NEXT_PUBLIC_SITE_URL=https://amazonsafetypro.com


# ─── REQUIRED · Replace placeholder values ──────────────────────────────────
# Current local file has dummy values (+1234567890). Update with real numbers
# before production launch, or remove if not used.

NEXT_PUBLIC_PHONE_NUMBER=+1234567890       # TODO real number
NEXT_PUBLIC_WHATSAPP_NUMBER=+1234567890    # TODO real number


# ─── OPTIONAL · Contact form email delivery (Resend) ────────────────────────
# Without these, the contact form will submit but no lead email is sent.
# New owner should create their own Resend account at https://resend.com
# and verify the sender domain.

RESEND_API_KEY=                            # TODO from resend.com
RESEND_FROM_EMAIL=noreply@amazonsafetypro.com  # must be a verified domain on Resend
LEAD_INBOX_EMAIL=deepak@amazonsafetypro.com    # where leads land


# ─── OPTIONAL · Payment providers ───────────────────────────────────────────
# Only needed if accepting payment for the $299/$399 fixed-fee services.
# Pick ONE provider:
NEXT_PUBLIC_PAYMENT_PROVIDER=stripe        # or "paypal"

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=        # pk_live_... from stripe.com
STRIPE_SECRET_KEY=                         # sk_live_...

# --- PayPal ---
NEXT_PUBLIC_PAYPAL_CLIENT_ID=              # from paypal.com → developer
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live                           # or "sandbox" for testing


# ─── DO NOT MIGRATE (leftovers) ─────────────────────────────────────────────
# These were in the old local env but the code no longer uses them:
#   - NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
#   - TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_WHATSAPP_NUMBER
# Skip them on the new account.
