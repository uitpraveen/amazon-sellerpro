# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@amazonsafetypro.com
LEAD_INBOX_EMAIL=

# Payment provider — "paypal" or "stripe" (default: paypal).
# Only one provider is active at a time.
NEXT_PUBLIC_PAYMENT_PROVIDER=paypal

# PayPal — leave blank to run in MOCK mode (simulated payments for testing).
# For real sandbox testing: create a sandbox app at https://developer.paypal.com/
# and paste the Sandbox Client ID + Secret below. Set MODE=live for production.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Stripe — leave blank to run in MOCK mode.
# For real test mode: create test keys at https://dashboard.stripe.com/test/apikeys
# Publishable key (pk_test_...) goes in NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY.
# Secret key (sk_test_...) goes in STRIPE_SECRET_KEY.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
